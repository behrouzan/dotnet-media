<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>DotnetMedia.Imaging</PackageId>
    <Description>Validated raster image processing and named variants for dotnet-media.</Description>
    <PackageTags>media;images;magick;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DotnetMedia.Core\DotnetMedia.Core.csproj" />
  </ItemGroup>

</Project>
